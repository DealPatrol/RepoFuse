# Application and database
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@example.invalid/database?sslmode=require

# Legacy GitHub OAuth app. Optional when Clerk is configured and users sign in
# with GitHub (Clerk Dashboard → GitHub connection, including a custom OAuth app).
# Repo listing and file reads then use users.getUserOauthAccessToken(userId, "github").
# If both values below are set, the legacy authorize/callback flow is used instead.
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret
# Optional compatibility value used by client-side platform selection.
NEXT_PUBLIC_GITHUB_CLIENT_ID=github_client_id
# Personal or installation token used only by the standalone RepoFuse MCP server.
GITHUB_TOKEN=github_token

# GitLab OAuth
GITLAB_CLIENT_ID=gitlab_client_id
GITLAB_CLIENT_SECRET=gitlab_client_secret
NEXT_PUBLIC_GITLAB_CLIENT_ID=gitlab_client_id

# Vercel OAuth and preview deployment fallback
VERCEL_CLIENT_ID=vercel_oauth_client_id
VERCEL_CLIENT_SECRET=vercel_oauth_client_secret
NEXT_PUBLIC_VERCEL_CLIENT_ID=vercel_oauth_client_id
VERCEL_TOKEN=vercel_api_token
VERCEL_TEAM_ID=vercel_team_id

# GitHub Actions deployment workflow secrets
VERCEL_ORG_ID=vercel_org_id
VERCEL_PROJECT_ID=vercel_project_id

# Set automatically by Vercel; listed here because application code reads them.
VERCEL_OIDC_TOKEN=
VERCEL_ENV=
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_GIT_COMMIT_SHA=

# Additional platform OAuth settings used by /api/auth/connect-platform.
REPLIT_CLIENT_ID=replit_client_id
REPLIT_CLIENT_SECRET=replit_client_secret
NEXT_PUBLIC_REPLIT_CLIENT_ID=replit_client_id
NETLIFY_CLIENT_ID=netlify_client_id
NETLIFY_CLIENT_SECRET=netlify_client_secret
NEXT_PUBLIC_NETLIFY_CLIENT_ID=netlify_client_id

# AI providers
# AI Gateway is preferred on Vercel. VERCEL_OIDC_TOKEN can authenticate it.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=anthropic_api_key
OPENAI_API_KEY=openai_api_key
# Optional model overrides.
ANTHROPIC_ANALYSIS_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_MODEL=claude-opus-4-6
REPOFUSE_MODEL=claude-opus-4-6

# Stripe Billing
# STRIPE_MODE selects the matching *_LIVE or *_TEST values below.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=sk_test_placeholder
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_placeholder
STRIPE_PRO_PRICE_ID_TEST=price_test_pro
STRIPE_SCALE_PRICE_ID_TEST=price_test_scale
STRIPE_SECRET_KEY_LIVE=sk_live_placeholder
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_placeholder
STRIPE_PRO_PRICE_ID_LIVE=price_live_pro
STRIPE_SCALE_PRICE_ID_LIVE=price_live_scale
# Backward-compatible fallbacks when mode-specific values are not set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=

# Application security
# Generate independent random values, for example: openssl rand -hex 32
ENCRYPTION_SECRET=replace_with_random_32_byte_value
CRON_SECRET=replace_with_independent_random_value

# Clerk (optional; enables GitHub social sign-in at /sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase compatibility utilities (optional)
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=supabase_publishable_key

# Standalone RepoFuse MCP tuning (optional)
REPOFUSE_MAX_FILES_PER_REPO=120
REPOFUSE_MAX_BLUEPRINTS=5
